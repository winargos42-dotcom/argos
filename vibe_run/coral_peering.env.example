# ARGOS-VIBE peering template for the Coral node (winargos42-dotcom/argos gateway).
# Copy to the Coral machine as .env for its `main.py` gateway and fill in the
# tunnel hostname. NO SECRETS ARE CONTAINED HERE — every value is a placeholder.
#
# Security model (matches main.py design):
#   * Vibe node binds to 127.0.0.1 only — no public ingress exists or is allowed.
#   * The owner must run a private tunnel (Tailscale, WireGuard wg/, or
#     Cloudflare Access with Managed OAuth) from the Vibe host to make it
#     reachable exclusively for the Coral node.
#   * P2P endpoints stay disabled unless ARGOS_P2P_TOKEN is set on BOTH sides
#     with the same generated value (openssl rand -hex 32).

# --- On CORAL: peers pointing to ARGOS-VIBE through the private tunnel ------
ARGOS_NODE_ID=argos-coral
ARGOS_MCP_URL=http://<vibe-tunnel-host>:8000
ARGOS_BRAIN_API_URL=
ARGOS_PC_URL=

# --- On CORAL: P2P announce token (generate one, share out-of-band) ---------
# ARGOS_P2P_TOKEN=<openssl rand -hex 32>

# --- On VIBE (already applied in this deployment, loopback only) ------------
# ARGOS_NODE_ID=argos-vibe-sandbox
# ARGOS_MCP_URL=http://127.0.0.1:8000
# ARGOS_P2P_TOKEN=<same token as Coral, only if announce is wanted>

# Verification from Coral once the tunnel is up:
#   curl -s http://<vibe-tunnel-host>:8080/health
#   curl -s http://<vibe-tunnel-host>:8080/p2p/nodes
#
# --- Confirmed X230 facts (stage 4, reported by RootGuard) -------------------
# Core API  :8080  -> HTTP 200
# MCP API   :8000  -> HTTP 200
# Ollama    0.40.7 -> running
# cloudflared.service -> active
# Cloudflare Tunnel ID: 65032df5-2b9a-43f6-a6a9-c50344e98f9d
# Local tunnel service ports: 8123, 8765 (x230-mcp), 8878, 18888
# Public hostnames currently return HTTP 530 / Cloudflare error 1033 (tunnel
# routing is being diagnosed on the ARGOS side — do not poll them repeatedly).
#
# --- On VIBE: peering to X230 once a private channel exists -----------------
# No public endpoint is used. Point ARGOS_MCP_URL at the X230 MCP API only
# through the private tunnel (or SSH port-forward, e.g.
#   ssh -N -L 18000:127.0.0.1:8000 <x230-host>
# then ARGOS_MCP_URL=http://127.0.0.1:18000 on VIBE).
# ARGOS_X230_MCP_URL=http://127.0.0.1:18000
#
# NOTE: no live VIBE<->X230/Coral message exchange has occurred yet; the link
# is NOT declared operational until a real response arrives over the secure
# channel.
