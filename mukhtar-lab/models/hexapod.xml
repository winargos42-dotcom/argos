          <geom name="foot5" type="sphere" size="0.016" pos="0 0 -0.0752"
                mass="0.005" rgba="0.2 0.2 0.2 1" condim="3" priority="1"/>
        </body>
      </body>
    </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="coxa0" body2="tibia0"/>
    <exclude body1="coxa1" body2="tibia1"/>
    <exclude body1="coxa2" body2="tibia2"/>
