<mujoco model="argos_roach">

<!-- ================= ARGOS-Roach model parameters (UNITS: m, kg, rad, s) =================
  body      : box 0.16 x 0.12 x 0.035 m, mass 0.7 kg
  coxa      : box length 0.05 m, mass 0.035 kg, yaw joint range (-0.8, 0.8) rad
  femur     : capsule length 0.08 m, r 0.012 m, mass 0.055 kg, range (-1.3, 1.3) rad
  tibia     : capsule length 0.08 m, r 0.01 m, mass 0.045 kg, range (-2.6, 2.6) rad
  foot      : sphere r 0.016 m, mass 0.005 kg
  total mass: 1.54 kg ; leg span ~0.28 m tip-to-tip
  actuators : 18 position servos, kp 60.0 N*m/rad, gear 1, |force| <= 2.5 N*m
  standing q0 (rad): coxa 0, femur s*0.8, tibia -s*1.45  (s=+1 right, -1 left)
  timestep 0.002 s, Euler integrator, pyramidal friction cone.
  Body moves ONLY via foot-floor contact (free joint, no external forces).
============================================================================================ -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="Euler" cone="pyramidal" iterations="100"
          solver="Newton" jacobian="dense"/>

  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1" pos="0 0 0"
          friction="0.8 0.005 0.0001" condim="3" rgba="0.7 0.7 0.7 1"/>
    <body name="body" pos="0 0 0.15">
      <freejoint/>
      <geom name="body_geom" type="box" size="0.08 0.06 0.0175"
            mass="0.7" rgba="0.25 0.35 0.55 1"/>

    <body name="coxa0" pos="0.07 0.065 -0.02">
      <joint name="j_coxa0" type="hinge" axis="0 0 1"
             range="-0.8 0.8"
             damping="0.5" frictionloss="0.02"/>
      <geom name="coxa0" type="box" size="0.011 0.025 0.011"
            pos="0 0.025 0" mass="0.035" rgba="0.55 0.42 0.30 1"/>
      <body name="femur0" pos="0 0.05 0">
        <joint name="j_femur0" type="hinge" axis="1 0 0"
               range="-1.3 1.3"
               damping="0.8" armature="0.01" frictionloss="0.02"/>
        <geom name="femur0" type="capsule" size="0.012 0.04"
              pos="0 0 -0.04" mass="0.055" rgba="0.45 0.38 0.30 1"/>
        <body name="tibia0" pos="0 0 -0.08">
          <joint name="j_tibia0" type="hinge" axis="1 0 0"
                 range="-2.6 2.6"
                 damping="0.8" armature="0.01" frictionloss="0.02"/>
          <geom name="tibia0" type="capsule" size="0.01 0.04"
                pos="0 0 -0.04" mass="0.045" rgba="0.38 0.33 0.27 1"/>
          <geom name="foot0" type="sphere" size="0.016" pos="0 0 -0.0752"
                mass="0.005" rgba="0.2 0.2 0.2 1" condim="3" priority="1"/>
        </body>
      </body>
    </body>

    <body name="coxa1" pos="0.07 -0.065 -0.02">
      <joint name="j_coxa1" type="hinge" axis="0 0 1"
             range="-0.8 0.8"
