<mujoco model="argos_roach">
  <!-- ================= ARGOS-Roach model parameters (UNITS: m, kg, rad, s) =================
  body      : box 0.16 x 0.12 x 0.035 m, mass 0.7 kg
  coxa      : box length 0.05 m, mass 0.035 kg, yaw joint range (-0.8, 0.8) rad
  femur     : capsule length 0.08 m, r 0.012 m, mass 0.055 kg, range (-1.3, 1.3) rad
  tibia     : capsule length 0.08 m, r 0.01 m, mass 0.045 kg, range (-2.6, 2.6) rad
  foot      : sphere r 0.016 m, mass 0.005 kg
  total mass: 1.54 kg ; leg span ~0.28 m tip-to-tip
  actuators : 18 position servos, kp 60.0 N*m/rad, gear 1, |force| <= 2.5 N*m
  standing q0 (rad): coxa 0, femur s*0.8, tibia -s*1.45  (s=+1 right, -1 left)
  timestep 0.002 s, Euler integrator, pyramidal friction cone.
  Body moves ONLY via foot-floor contact (free joint, no external forces).
============================================================================================ -->
