        <body name="femur0" pos="0 0.05 0">
          <joint name="j_femur0" range="-1.3 1.3" armature="0.01" damping="0.8" frictionloss="0.02" axis="1 0 0"/>
          <geom name="femur0" size="0.012 0.04" pos="0 0 -0.04" type="capsule" rgba="0.45 0.38 0.3 1" mass="0.055"/>
          <body name="tibia0" pos="0 0 -0.08">
            <joint name="j_tibia0" range="-2.6 2.6" armature="0.01" damping="0.8" frictionloss="0.02" axis="1 0 0"/>
