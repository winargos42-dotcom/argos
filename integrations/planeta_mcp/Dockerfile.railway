FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        xvfb \
        x11vnc \
        novnc \
        websockify \
    && test -f /usr/share/novnc/core/rfb.js \
    && command -v Xvfb \
    && command -v x11vnc \
    && command -v websockify \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/planeta-requirements.txt
RUN pip install --no-cache-dir -r /tmp/planeta-requirements.txt \
    && python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /app/integrations/planeta_mcp /data/planeta \
    && touch /app/integrations/__init__.py \
    && chown -R app:app /app /data/planeta

COPY --chown=app:app . /app/integrations/planeta_mcp
RUN python -m compileall /app/integrations/planeta_mcp \
    && python -c "from integrations.planeta_mcp.server import REGISTERED_TOOL_NAMES; from integrations.planeta_mcp.entry_server import app; assert len(REGISTERED_TOOL_NAMES) == 8; assert app is not None"

USER app
EXPOSE 8000

CMD ["uvicorn", "integrations.planeta_mcp.entry_server:app", "--host", "0.0.0.0", "--port", "8000"]
